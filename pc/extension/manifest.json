{
  "manifest_version": 3,
  "name": "PiClock mail",
  "version": "1.0",
  "description": "Shows the unread mail from the webmail tabs you have open on the PiClock screen, through this PC's SSH link to the Pi. Nothing goes to the internet.",
  "key": "",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["nativeMessaging", "storage", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "PiClock mail" },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://login.microsoftonline.com/*",
        "https://login.live.com/*",
        "https://mail.google.com/*",
        "https://mail.yahoo.com/*",
        "https://www.icloud.com/mail*"
      ],
      "js": ["readers.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
